// The generator behind `#mcp.tool`, `#mcp.resource` and `#mcp.prompt`: the
// functions a package annotates, registered on a server in one function the
// program calls at start-up. moonx runs it as a dev_build rule; see the README.
supported_targets = "+native+wasm"

pkgtype(kind: "executable")

import {
  "moonbitstack/moonast/quote",
  "moonbitstack/moonast/attr",
  "moonbitstack/moonast/gen",
  "moonbitstack/moonast/cli",
  "moonbitlang/parser/attribute",
  "moonbitlang/async",
  "moonbitlang/core/env",
}
