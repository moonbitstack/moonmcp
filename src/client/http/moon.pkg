// The HTTP transport of the client, kept out of `client` so a program that
// only speaks to a server in its own process carries no HTTP stack.
supported_targets = "+native"

import {
  "moonbitstack/moonmcp/client",
  "moonbitstack/moonmcp/server",
  "moonbitlang/async",
  "moonbitlang/async/http" @net,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}
