  "moonbitstack/moonmcp/docs",
  "moonbitstack/moonmcp/auth",
  "moonbitstack/moonmcp/providers",
  "moonbitstack/moonmcp/transforms",
  "moonbitstack/moonmcp/layers",
  "moonbitstack/moonlog",
  "moonbitstack/moonschema",
  "moonbitstack/moonasgi",
  "moonbitstack/moonbase/base64",
  "moonbitstack/moonjrpc",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async/stdio",
  "moonbitlang/async/io",
  "moonbitlang/async/aqueue",
